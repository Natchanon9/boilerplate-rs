# Local settings. `make env` copies this file to .env and generates AUTH_JWT_SECRET.
# .env is gitignored; this file holds placeholders only (security.md SEC-9).
# Precedence: flag > environment > .env (docs/conventions/runtime.md).

APP_NAME=rs-boilerplate
APP_ENV=local
LOG_LEVEL=info
# Optional features to switch on, comma-separated: cache, kafka. Empty means neither, so a
# fresh clone starts only postgres and the app. Set `cache,kafka` for the full demo stack.
ENABLE_FEATURES=
# `make up` sets the compose profiles (cache, kafka) from ENABLE_FEATURES, so you do not set
# COMPOSE_PROFILES. Only plain `docker compose up` needs it, with the same value:
# COMPOSE_PROFILES=cache,kafka

HOST=0.0.0.0
PROTECTED_API_PORT=8080
PUBLIC_API_PORT=8081
HIDDEN_API_PORT=8079

DB_PLATFORM=postgres
# Host-side URLs, used by cargo, sqlx, and the tests. docker compose points the app
# container at the service names instead.
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# HS256 secret, at least 32 bytes (RFC 7518 3.2). The app refuses to start while it is empty.
AUTH_JWT_SECRET=
AUTH_ISSUER=rs-boilerplate-dev
AUTH_AUDIENCE=rs-boilerplate

CACHE_TTL_SECS=300
# Development only: adds the X-Cache header. The app refuses to start with it when
# APP_ENV=production (security.md SEC-6).
CACHE_DEBUG_HEADER=false
